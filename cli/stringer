#!/usr/bin/env python3
"""stringer:「什么值得做」(stringers.io)的命令行。只用标准库,一个文件。

  stringer feed [--day 2026-11-11] [-q 词]  市场动态:数据上突然涨起来的小产品,逐条查过为什么涨(不带参数 = 最新一天)
  stringer feed <slug>             一条动态的完整调查:定位、对手、时间线、出处
  stringer plays [-q 词]           打法:从这些调查里归纳的、能照着做的做法
  stringer plays p04               一条打法全文:分步骤、案例、反例、适合谁
  stringer hot                     编辑挑的爆款单品
  stringer products [--sec apps] [--grade AB] [-q 词] [--growth 正则] [--key K [--part growth]]  在涨的产品(App / GitHub / Chrome 插件 / 网站)
  stringer status                  16 个库今天跑完没有、数据到哪天
  stringer libs                    能查的库
  stringer schema <库>             某个库的说明(表、口径、边界);第一次查一个库先看它
  stringer <库> <参数…>            直接查库,参数 = 该库命令的参数,如 stringer indie top --min 1000
  stringer mcp                    以 stdio MCP server 跑(只认本地命令的客户端用;能连远程 MCP 的直接连 stringers.io/mcp/<token>)

除了 status 都要 token:环境变量 STRINGER_KEY 或 ~/.config/stringer/key(wt_ 开头的 token,或整条 https://stringers.io/mcp/<token> 地址都行)。
没有 token 时 stringer feed 退回读首页的 Markdown 版(https://stringers.io/index.md,公开)。
约 90 个「方向」的长文和评级 2026-11-12 起停止更新;stringer list / show <编号> 还能读那份存档。
token 在 https://stringers.io 右上角登录后「配置 agent」里拿。"""
import json, os, sys, urllib.request, urllib.parse, urllib.error

SITE = os.environ.get('STRINGER_SITE', 'https://stringers.io').rstrip('/')
LIBS = {
    'indie': '独立产品的支付平台校验收入(TrustMRR,约 1.2 万个产品,逐日 / 逐月)',
    'forsale': '在售的小生意(Flippa / Acquire 等):要价、收入、利润,卖家自填',
    'appstore': 'App Store 115 个区的榜单、评分、评论、新上架(苹果不给下载和收入)',
    'googleplay': 'Google Play 30 个区:榜单、精确安装量、评分',
    'macappstore': 'Mac App Store 20 个区的免费 / 付费榜',
    'chromestore': 'Chrome 商店扩展:用户数、评分、版本、收费迹象',
    'shopifyapps': 'Shopify 应用商店:评论、评分、定价',
    'github': 'GitHub ≥50 星的库约 85 万个,每天拍星数,加 trending 快照',
    'producthunt': 'Product Hunt 的发布、票数、makers(2013 年起)',
    'hackernews': 'Hacker News 故事与分数,Show HN(2024 年起)',
    'metaads': 'Meta 广告库:谁在投、投多少条、落地页',
    'googleads': 'Google 广告透明中心:名单上的开发者在不在投',
    'tiktokads': 'TikTok 广告库(欧洲)',
    'crossing': '过线名单:每天在 7 个库上算「今天刚冒头的」',
    'x': 'X 上五个圈子(AI 创始人 / 独立开发者 / 研究员 / 美股投资人 / VC)成员的原创帖',
}


def key():
    k = os.environ.get('STRINGER_KEY', '').strip() or os.environ.get('WORTH_KEY', '').strip()
    for f in ('~/.config/stringer/key', '~/.config/worth/key'):
        if k: break
        try: k = open(os.path.expanduser(f)).read().strip()
        except OSError: k = ''
    return k


def get(url, timeout=150):
    try:
        with urllib.request.urlopen(urllib.request.Request(url, headers={'User-Agent': 'stringer-cli/0.4'}), timeout=timeout) as r:
            return r.read().decode('utf-8', 'replace')
    except urllib.error.HTTPError as e:
        body = e.read().decode('utf-8', 'replace')[:300]
        sys.exit(f'HTTP {e.code}:{body}')
    except urllib.error.URLError as e:
        sys.exit(f'连不上 {SITE}:{e.reason}')


def jget(path):
    return json.loads(get(f'{SITE}{path}', timeout=30))


def money(x):
    m = x.get('money') or {}
    return f"{m.get('total', '')} {m.get('kind', '')}".strip()


def line(x, why=False):
    s = f"{x['id']}  [{x['grade']} {x.get('grade_note', '')}]  {x.get('title', '')}"
    if money(x): s += f"   ·  {money(x)}"
    if why and x.get('grade_why'): s += f"\n      {x['grade_why']}"
    return s


def cmd_list(a):
    d = jget('/api/all.json'); items = d['items']
    if '--grade' in a:
        gs = set(a[a.index('--grade') + 1].upper().replace(',', ''))
        items = [x for x in items if x['grade'] in gs]
    if '--json' in a: return print(json.dumps(items, ensure_ascii=False, indent=1))
    print(f"什么值得做 · {d['n']} 个方向(存档,2026-11-12 起停止更新)· 评级 = 成功率(主看窗口期和有多赚钱)\n")
    order = 'SABCDE'
    for g in order:
        grp = [x for x in items if x['grade'] == g]
        if not grp: continue
        print(f"{g} {d['grades'].get(g, '')}  {len(grp)} 条")
        for x in grp: print('  ' + line(x, why=g in 'SA'))
        print()


def cmd_show(a):
    ids = [x for x in a if x.isdigit()]
    if not ids: sys.exit('用法:stringer show <编号>,如 stringer show 043')
    i = ids[0].zfill(3)
    d = jget('/api/all.json'); x = next((y for y in d['items'] if y['id'] == i), None)
    if not x: sys.exit(f'没有 {i}')
    full = {}
    if x.get('json'):
        try: full = json.loads(get(x['json'], timeout=30))
        except SystemExit: full = {}
    if '--json' in a: return print(json.dumps(full or x, ensure_ascii=False, indent=1))
    print(f"[{x['grade']} {x.get('grade_note', '')}] {x.get('headline') or x.get('title')}")
    if x.get('headline'): print(f"    {x['title']}")
    print(f"\n判断:{x.get('verdict', '')}\n    {x.get('sub', '')}")
    if x.get('grade_why'): print(f"为什么这个级:{x['grade_why']}")
    m = x.get('money') or {}
    if m: print(f"钱:{m.get('total', '')} {m.get('kind', '')}({m.get('n')} 家)\n    {m.get('note', '')}")
    rows = full.get('rows') or {}
    if rows:
        print()
        for k, v in rows.items():
            if v: print(f"{k}:{v}")
    who = full.get('who') or x.get('who') or []
    if who:
        print('\n谁在做')
        for w in who:
            if isinstance(w, dict): print(f"  - {w.get('name', '')}  {w.get('url', '')}" + (f"\n      {w['what']}" if w.get('what') else ''))
    wrong = full.get('wrong') or x.get('wrong') or []
    if wrong:
        print('\n什么情况下这个判断会错')
        for w in wrong: print(f"  - {w}")
    notes = x.get('notes') or []
    if notes:
        print('\n最新')
        for n in notes: print(f"  {n['date']}  {n['note']}")
    print(f"\n存档:这批方向 2026-11-12 起停止更新 · 全文 {x.get('url', '')}")


def cmd_status(a):
    s = jget('/status.json')
    if '--json' in a: return print(json.dumps(s, ensure_ascii=False, indent=1))
    print(f"数据层 {s['generated'].replace('T', ' ')} · 数据到 {s['data_to']} · {'全部正常' if s['ok'] else '有问题'} · /data {s['disk']['data_gb']} GB\n")
    for r in s['libs']:
        db = f"{r['db']['size_mb']} MB" if r.get('db') else '—'
        print(f"  {r['name']:<12}{r['state']:<6}定时 {r['at']:<14}最近结束 {(r['last_end'] or '—')[5:16]:<13}{db:<10}{';'.join(r.get('note', []))}")


def cmd_libs(a):
    print('能查的库(stringer <库> --help 看子命令,stringer schema <库> 看口径和边界):\n')
    for k, v in LIBS.items(): print(f"  {k:<12}{v}")
    print('\n找钱:indie、forsale;需求与榜单:appstore、googleplay、macappstore、chromestore、shopifyapps;开发者侧热度:github、producthunt、hackernews;'
          '谁在买量:metaads、googleads、tiktokads;今天刚冒头:crossing;圈子议论:x。')


def data(lib, args):
    k = key()
    if not k: sys.exit('查库要 token:export STRINGER_KEY=wt_…(或写到 ~/.config/stringer/key)。到 https://stringers.io 右上角登录,「配置 agent」里能看到')
    q = urllib.parse.urlencode({'lib': lib, 'args': args})
    k = k.rsplit('/mcp/', 1)[-1].strip('/')             # 也接受整条 MCP 地址
    path = f'mcp/{k}' if k.startswith('wt_') else k     # wt_ 开头是公开门的 token;旧钥匙是路径段
    return get(f'{SITE}/{path}/data?{q}')


def tool(name, args):
    """调远程 MCP 门的一个工具(feed / plays / hot / products),返回文本。"""
    k = key()
    if not k: sys.exit('要 token:export STRINGER_KEY=wt_…(或写到 ~/.config/stringer/key)。到 https://stringers.io 右上角登录,「配置 agent」里能看到')
    k = k.rsplit('/mcp/', 1)[-1].strip('/')
    url = f'{SITE}/mcp/{k}'

    def rpc(method, params, sid=None, i=1):
        h = {'Content-Type': 'application/json', 'Accept': 'application/json, text/event-stream', 'User-Agent': 'stringer-cli/0.4'}
        if sid: h['Mcp-Session-Id'] = sid
        try:
            with urllib.request.urlopen(urllib.request.Request(url, json.dumps({'jsonrpc': '2.0', 'id': i, 'method': method, 'params': params}).encode(), h), timeout=150) as r:
                t = r.read().decode('utf-8', 'replace'); sid = r.headers.get('Mcp-Session-Id') or sid
        except urllib.error.HTTPError as e: sys.exit(f'HTTP {e.code}:{e.read().decode("utf-8", "replace")[:300]}')
        except urllib.error.URLError as e: sys.exit(f'连不上 {SITE}:{e.reason}')
        d = [l[5:].strip() for l in t.splitlines() if l.startswith('data:')]
        return sid, json.loads(d[-1] if d else t)

    sid, _ = rpc('initialize', {'protocolVersion': '2025-03-26', 'capabilities': {}, 'clientInfo': {'name': 'stringer-cli', 'version': '0.4'}})
    _, r = rpc('tools/call', {'name': name, 'arguments': args}, sid, 2)
    if r.get('error'): sys.exit(str(r['error'].get('message', r['error'])))
    return '\n'.join(c.get('text', '') for c in r.get('result', {}).get('content', []))


def opts(a, flags):
    """把 --day X / -q X 这类参数拆出来,剩下的是位置参数。flags:{命令行写法: 工具参数名}。"""
    out, rest, i = {}, [], 0
    while i < len(a):
        if a[i] in flags and i + 1 < len(a): out[flags[a[i]]] = a[i + 1]; i += 2
        elif a[i] == '--past': out['past'] = True; i += 1
        else: rest.append(a[i]); i += 1
    return out, rest


def cmd_feed(a):
    o, rest = opts(a, {'--day': 'day', '-q': 'q', '--q': 'q'})
    if rest: o['slug'] = rest[0]
    if not key() and not o: return print(get(f'{SITE}/index.md', timeout=30))
    print(tool('feed', o))


def cmd_plays(a):
    o, rest = opts(a, {'-q': 'q', '--q': 'q'})
    if rest: o['id'] = rest[0]
    print(tool('plays', o))


def cmd_hot(a):
    print(tool('hot', opts(a, {})[0]))


def cmd_products(a):
    o, rest = opts(a, {'--sec': 'sec', '--grade': 'grade', '-q': 'q', '--q': 'q', '--key': 'key', '--growth': 'growth', '--part': 'part'})
    if rest and 'key' not in o: o['key'] = rest[0]
    print(tool('products', o))


def cmd_schema(a):
    libs = [x for x in a if x in LIBS]
    if not libs: sys.exit('用法:stringer schema <库>;库:' + ', '.join(LIBS))
    print(data(libs[0], 'schema'))


def shell_join(parts):
    out = []
    for p in parts:
        if any(c in p for c in ' "\'') or p == '': out.append('"' + p.replace('"', '\\"') + '"')
        else: out.append(p)
    return ' '.join(out)


def cmd_lib(lib, rest):
    print(data(lib, shell_join(rest)))


# ---------------------------------------------------------------- stdio MCP(最小实现:initialize / tools/list / tools/call)
def mcp():
    tools = [
        {'name': 'feed', 'description': '市场动态:数据上突然涨起来的小产品(App、开源项目、插件、网站、独立产品收入),每条都逐个调查过为什么是这几天涨,每天更新。不带参数给最新一天;day="2026-11-10" 看某一天;q 按短词在全部日期里搜;slug 读一条的完整调查(定位、对手、时间线、出处)。问「最近什么在涨」「某个产品为什么火了」先用它。',
         'inputSchema': {'type': 'object', 'properties': {'day': {'type': 'string'}, 'q': {'type': 'string'}, 'slug': {'type': 'string'}}}},
        {'name': 'plays', 'description': '打法:从市场动态的调查里归纳的、小团队能照着做的做法,每条有分步骤、真实案例、照做却没成的反例、适合谁。不带参数给清单;id="p03" 读全文;q 按短词搜。',
         'inputSchema': {'type': 'object', 'properties': {'id': {'type': 'string'}, 'q': {'type': 'string'}}}},
        {'name': 'hot', 'description': '爆款单品:编辑每天挑的、正在爆而且小团队有机会的单个产品。past=true 连已下榜的也给。', 'inputSchema': {'type': 'object', 'properties': {'past': {'type': 'boolean'}}}},
        {'name': 'products', 'description': '在涨的单个产品(移动端 App / GitHub 项目 / Chrome 插件 / 网站),每个都研究过为什么跑出来并给了等级(S 最值得跟,E 别碰)。sec 选 apps / github / chrome / web;grade、q 筛;key 读整篇;growth 是正则,按「怎么起量」搜案例;key 加 part="growth" 只读它怎么拿到用户。',
         'inputSchema': {'type': 'object', 'properties': {'sec': {'type': 'string'}, 'grade': {'type': 'string'}, 'q': {'type': 'string'}, 'key': {'type': 'string'}, 'growth': {'type': 'string'}, 'part': {'type': 'string'}}}},
        {'name': 'data', 'description': '直接查一个数据层(只读)。lib:' + ', '.join(LIBS) + '。args 是该库命令的参数,如 "coverage"、"top --min 1000"、\'search "stock checker" --cc us --top 8\';'
         '第一次用某个库先 args="schema" 看说明,再 "coverage" 看边界;某子命令参数不清楚就 "<子命令> --help"。多词关键词加引号。',
         'inputSchema': {'type': 'object', 'properties': {'lib': {'type': 'string'}, 'args': {'type': 'string'}}, 'required': ['lib']}},
        {'name': 'status', 'description': '16 个库今天跑完没有、数据到哪天。', 'inputSchema': {'type': 'object', 'properties': {}}},
    ]
    import io, contextlib

    def capture(fn, *a):
        buf = io.StringIO()
        try:
            with contextlib.redirect_stdout(buf): fn(*a)
        except SystemExit as e: buf.write(str(e))
        return buf.getvalue()

    def call(name, args):
        if name in ('feed', 'plays', 'hot', 'products'):
            try: return tool(name, {k: v for k, v in args.items() if v not in ('', None)})
            except SystemExit as e: return str(e)
        if name == 'status': return capture(cmd_status, [])
        if name == 'data':
            lib = (args.get('lib') or '').strip()
            if lib not in LIBS: return f'没有这个库:{lib}。能查的:{", ".join(LIBS)}'
            try: return data(lib, args.get('args') or 'schema')
            except SystemExit as e: return str(e)
        return f'没有这个工具:{name}'

    def send(obj):
        sys.stdout.write(json.dumps(obj, ensure_ascii=False) + '\n'); sys.stdout.flush()

    for raw in sys.stdin:
        raw = raw.strip()
        if not raw: continue
        try: req = json.loads(raw)
        except ValueError: continue
        mid, method, params = req.get('id'), req.get('method'), req.get('params') or {}
        if method == 'initialize':
            send({'jsonrpc': '2.0', 'id': mid, 'result': {'protocolVersion': params.get('protocolVersion', '2025-06-18'), 'capabilities': {'tools': {}},
                                                           'serverInfo': {'name': 'stringer', 'version': '0.4'}, 'instructions': '最近什么在涨、为什么涨看 feed;能照着做的做法看 plays;单个产品的研究看 products / hot;要原始数据用 data,第一次查某个库先看 schema。每个数字带日期和来自哪个库。'}})
        elif method == 'tools/list':
            send({'jsonrpc': '2.0', 'id': mid, 'result': {'tools': tools}})
        elif method == 'tools/call':
            text = call(params.get('name'), params.get('arguments') or {})
            send({'jsonrpc': '2.0', 'id': mid, 'result': {'content': [{'type': 'text', 'text': text}]}})
        elif method == 'ping':
            send({'jsonrpc': '2.0', 'id': mid, 'result': {}})
        elif mid is not None:
            send({'jsonrpc': '2.0', 'id': mid, 'error': {'code': -32601, 'message': f'不支持:{method}'}})
        # notifications(initialized 等)不回


def main():
    a = sys.argv[1:]
    if not a or a[0] in ('-h', '--help', 'help'): return print(__doc__)
    c, rest = a[0], a[1:]
    if c in ('feed', 'today'): return cmd_feed(rest)       # today 是旧名字(方向简报 2026-11-12 停更),现在等于最新一天的市场动态
    if c == 'plays': return cmd_plays(rest)
    if c == 'hot': return cmd_hot(rest)
    if c == 'products': return cmd_products(rest)
    if c == 'list': return cmd_list(rest)
    if c == 'show': return cmd_show(rest)
    if c == 'status': return cmd_status(rest)
    if c == 'libs': return cmd_libs(rest)
    if c == 'schema': return cmd_schema(rest)
    if c == 'mcp': return mcp()
    if c in LIBS: return cmd_lib(c, rest)
    sys.exit(f'不认识 {c}。stringer --help 看用法;stringer libs 看能查的库。')


if __name__ == '__main__':
    try: main()
    except BrokenPipeError: os._exit(0)      # 输出接到 head 之类提前关掉的管道
